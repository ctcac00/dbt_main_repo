core.workflow(
    name = "default",
    origin = git.origin(
        url = "git@github.com:ctcac00/dbt_main_repo.git",
        ref = "main",
    ),
    destination = git.destination(
        url = "git@github.com:ctcac00/dbt_clone_repo.git",
        push = "main",
    ),
    authoring = authoring.pass_thru("dbt_main_repo <noreply@github.com>"),
    origin_files = glob(["**"]),
    destination_files = glob(["**"]),
    mode = "ITERATIVE",
)
